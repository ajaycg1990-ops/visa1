# NIEC Visa AI - production settings.
#
# On the server:  cp deploy/production.env.example .env  &&  nano .env
# Then run:       node scripts/preflight.mjs   (it must show no FAIL)
#
# Generate each secret below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep a copy of this file somewhere safe and off the server: without
# DATA_ENCRYPTION_KEY nobody can read the student data, and it is not in git.

NODE_ENV=production

# Two different long random strings.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# Your real address. Caddy sends /api/* to the backend, so all three are the
# same https domain. Staff sign in at <this address>/admin/
PUBLIC_APP_URL=https://visa.niec.edu.np
PUBLIC_API_URL=https://visa.niec.edu.np
CORS_ORIGINS=https://visa.niec.edu.np

# Behind Caddy both servers listen only on this machine.
HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=4000

# A NEW OpenAI key with a monthly spending limit set on platform.openai.com.
# Leave empty to run on the built-in engine.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# No demo student on a public site.
SEED_DEMO=0

# Optional: password-reset emails through Resend, and Google sign-in.
RESEND_API_KEY=
FROM_EMAIL=
GOOGLE_CLIENT_ID=
